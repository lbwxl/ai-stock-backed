# 服务器 JAR 部署模板：复制为 /opt/ai-stock/config/backend.env 后填写实际值。
# 本文件不含真实凭据，不修改本机 .local/backend.env。
# Spring 标准变量直接覆盖 JAR 内配置，不依赖额外的 application-prod.yml。

# 后端服务：与 Nginx 同机时可设置 SERVER_ADDRESS=127.0.0.1。
SERVER_PORT=18080
# SERVER_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=druid

# MySQL：填写实际数据库、账号及密码。
SPRING_DATASOURCE_DRUID_MASTER_URL='jdbc:mysql://127.0.0.1:3306/ry-vue?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai'
SPRING_DATASOURCE_DRUID_MASTER_USERNAME=ai_stock
SPRING_DATASOURCE_DRUID_MASTER_PASSWORD='replace-with-database-password'

# Redis：如果未设置密码，将 SPRING_REDIS_PASSWORD 改为空值。
SPRING_REDIS_HOST=127.0.0.1
SPRING_REDIS_PORT=6379
SPRING_REDIS_DATABASE=0
SPRING_REDIS_PASSWORD='replace-with-redis-password'

# 登录 JWT：设置为足够长的随机密钥，所有后端实例保持一致。
# 修改该值会使旧 JWT 无法通过校验。
TOKEN_SECRET='replace-with-a-long-random-secret'
TOKEN_EXPIRETIME=30

# 常规业务上传目录与日志目录：Java 运行用户必须有写权限。
RUOYI_PROFILE=/opt/ai-stock/uploads
RUOYI_LOG_PATH=/opt/ai-stock/logs
LOGGING_LEVEL_COM_RUOYI=info
SWAGGER_ENABLED=false

# 文件分析存储：现有 MinIO 地址；生产可改为配置好证书的 HTTPS 地址。
FILE_ANALYSIS_STORAGE_TYPE=minio
MINIO_ENDPOINT=http://121.37.69.26:9000
MINIO_ACCESS_KEY='replace-with-minio-access-key'
MINIO_SECRET_KEY='replace-with-minio-secret-key'
MINIO_BUCKET=ai-file
MINIO_REGION=us-east-1
MINIO_PREFIX=file-analysis/

# 可选：模型和浏览器下载地址不同于上传地址时设置，默认使用 MINIO_ENDPOINT。
# MINIO_PUBLIC_ENDPOINT=https://files.example.com
