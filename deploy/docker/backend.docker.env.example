# 复制为 backend.docker.env，供 docker run --env-file 读取。
# 每行 KEY=VALUE；值不要加引号，不写 export，不引用其他变量。
# $、空格、单引号、双引号按原值填写；勿将密码写成行尾注释。
# 本文件只填写运行配置，不会被复制进镜像。

# Ubuntu 宿主机网络模式下，127.0.0.1 指向服务器本身。
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=18080
SPRING_PROFILES_ACTIVE=druid

SPRING_DATASOURCE_DRUID_MASTER_URL=jdbc:mysql://127.0.0.1:3306/ry-vue?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_DRUID_MASTER_USERNAME=ai_stock
SPRING_DATASOURCE_DRUID_MASTER_PASSWORD=replace-with-database-password

SPRING_REDIS_HOST=127.0.0.1
SPRING_REDIS_PORT=6379
SPRING_REDIS_DATABASE=0
SPRING_REDIS_PASSWORD=

# 填写固定随机密钥；可用 openssl rand -hex 32 生成，已有实例沿用原值。
TOKEN_SECRET=replace-with-a-long-random-secret
TOKEN_EXPIRETIME=30

FILE_ANALYSIS_STORAGE_TYPE=minio
MINIO_ENDPOINT=http://121.37.69.26:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=ai-file
MINIO_REGION=us-east-1
MINIO_PREFIX=file-analysis/

# /data 由 Docker 命名卷持久化。填写容器内路径，不填写本机 Mac 路径。
RUOYI_PROFILE=/data/uploads
RUOYI_LOG_PATH=/data/logs
WEBUI_FILEANALYSIS_STORAGEPATH=/data/ai-files
LOGGING_LEVEL_COM_RUOYI=info
SWAGGER_ENABLED=false
TZ=Asia/Shanghai
