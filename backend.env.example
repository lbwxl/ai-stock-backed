# Copy to .local/backend.env for start-local.sh and IDEA's local profile.
# Use unquoted KEY=value assignments without export. For values requiring shell
# quoting/escaping, inject process environment variables instead.
# Production deployments inject environment variables directly.
FILE_ANALYSIS_STORAGE_TYPE=minio
MINIO_ENDPOINT=https://files.example.com
# Set only when the model/browser download endpoint differs from the upload endpoint.
# MINIO_PUBLIC_ENDPOINT=https://files.example.com
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=ai-file
MINIO_REGION=us-east-1
MINIO_PREFIX=file-analysis/
